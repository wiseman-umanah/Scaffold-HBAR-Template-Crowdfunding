# Factory contract address — printed by: pnpm run deploy:factory (in packages/hardhat/)
NEXT_PUBLIC_FACTORY_ADDRESS=

# Block number the factory was deployed at — also printed by pnpm run deploy:factory
# Informational only in Next.js; mirror node is used for all log queries.
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=

# WalletConnect Cloud project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
