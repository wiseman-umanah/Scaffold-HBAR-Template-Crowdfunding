# Factory contract address — printed by: pnpm deploy (in packages/hardhat/)
NEXT_PUBLIC_FACTORY_ADDRESS=

# Block number the factory was deployed at — also printed by pnpm deploy
# Required: Hedera Hashio only allows eth_getLogs over a 7-day block window.
# Without this, the app defaults to "current block - 7 days" which misses older campaigns.
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=

# WalletConnect Cloud project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
